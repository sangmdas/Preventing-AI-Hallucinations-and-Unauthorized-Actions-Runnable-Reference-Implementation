{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcad.schema.json",
  "title": "HCADReferenceExtension",
  "description": "Reference HCAD including the repository candidateActDigest extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hcadId", "actId", "outputHash", "candidateActDigest", "originatingSystemId", "alfId", "rbdId", "opcId", "rcaeId", "policyEpoch", "revocationEpoch", "finalitySinkId", "recipient", "purpose", "jurisdiction", "riskClass", "timestamp", "nonce", "evidenceRefs"],
  "properties": {
    "hcadId": {"type": "string", "minLength": 1},
    "actId": {"type": "string", "minLength": 1},
    "outputHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateActDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "originatingSystemId": {"type": "string", "minLength": 1},
    "alfId": {"type": "string", "minLength": 1},
    "rbdId": {"type": "string", "minLength": 1},
    "opcId": {"type": "string", "minLength": 1},
    "rcaeId": {"type": "string", "minLength": 1},
    "policyEpoch": {"type": "integer", "minimum": 0},
    "revocationEpoch": {"type": "integer", "minimum": 0},
    "finalitySinkId": {"type": "string", "minLength": 1},
    "recipient": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "riskClass": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 1},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
